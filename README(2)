  provider: "openai"
  model: "gpt-4.1-mini"
  api_key: "..."

coder:
  provider: "anthropic"
  model: "claude-3.7-sonnet"
  api_key: "..."

small_agent:
  provider: "google"
  model: "gemini-2.0-flash"
  api_key: "..."
```

Replacing your model is as simple as editing this YAML.

